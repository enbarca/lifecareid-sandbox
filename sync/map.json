{
  "about": "Maps upstream files in the lifecareid checkout to this kit. Read by scripts/sync-upstream.mjs. Substitutions are literal and counted: a substitution that does not match exactly the stated number of times stops the sync. The script holds the allow-list of upstream directories itself. The private names list is not held here: the script reads the program's names file from --names-file or NAMES_GATE_FILE and refuses to run without it.",
  "files": [
    {
      "from": "libs/sandbox-source/source.js",
      "to": "source/source.js",
      "replace": []
    },
    {
      "from": "libs/sandbox-source/personas.generated.js",
      "to": "source/personas.generated.js",
      "replace": []
    },
    {
      "from": "libs/sandbox-source/data/personas.json",
      "to": "source/data/personas.json",
      "replace": []
    },
    {
      "from": "libs/sandbox-source/data/simulator-extract.json",
      "to": "source/data/simulator-extract.json",
      "replace": []
    },
    {
      "from": "functions/sandbox-source/[[path]].js",
      "to": "pages/functions/sandbox-source/[[path]].js",
      "replace": [
        {
          "find": "\"../../libs/sandbox-source/source.js\"",
          "with": "\"../../../source/source.js\"",
          "count": 1
        }
      ]
    },
    {
      "from": "functions/.well-known/oauth-protected-resource/[[path]].js",
      "to": "pages/functions/.well-known/oauth-protected-resource/[[path]].js",
      "replace": [
        {
          "find": "\"../../../libs/sandbox-source/source.js\"",
          "with": "\"../../../../source/source.js\"",
          "count": 1
        }
      ]
    },
    {
      "from": "tests/js/sandbox_source.test.mjs",
      "to": "source/source.test.mjs",
      "replace": [
        {
          "find": "(functions/sandbox-source/[[path]].js,\n// libs/sandbox-source/source.js)",
          "with": "(source.js, mounted by the Pages function in\n// pages/functions/sandbox-source/)",
          "count": 1
        },
        {
          "find": "node --test tests/js/*.test.mjs",
          "with": "node --test (from the kit root)",
          "count": 1
        },
        {
          "find": "\"../../functions/",
          "with": "\"../pages/functions/",
          "count": 1
        },
        {
          "find": "\"../../libs/sandbox-source/",
          "with": "\"./",
          "count": 2
        }
      ]
    },
    {
      "from": "tests/js/sandbox_source_prm.test.mjs",
      "to": "source/source.prm.test.mjs",
      "replace": [
        {
          "find": "node --test tests/js/*.test.mjs",
          "with": "node --test (from the kit root)",
          "count": 1
        },
        {
          "find": "\"../../functions/",
          "with": "\"../pages/functions/",
          "count": 2
        },
        {
          "find": "\"../../libs/sandbox-source/",
          "with": "\"./",
          "count": 1
        }
      ]
    },
    {
      "from": "tests/js/sandbox_source_401_scope.test.mjs",
      "to": "source/source.401-scope.test.mjs",
      "replace": [
        {
          "find": "node --test tests/js/*.test.mjs",
          "with": "node --test (from the kit root)",
          "count": 1
        },
        {
          "find": "\"../../functions/",
          "with": "\"../pages/functions/",
          "count": 1
        }
      ]
    }
  ],
  "contract": {
    "from": "docs/contracts/openapi.json",
    "to": "contract/openapi.json",
    "readme": {
      "path": "contract/README.md",
      "line_prefix": "Copy in this folder: ",
      "line": "Copy in this folder: **version {version}**, {paths} paths, taken from the upstream contract at commit `{short}` of {date}."
    }
  },
  "upstream_file": "sync/UPSTREAM"
}
