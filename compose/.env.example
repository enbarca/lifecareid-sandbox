# Copy to compose/.env (git-ignored). The source's own client at the hosted
# sandbox: register one with your developer access token, as compose/README.md
# shows, and paste the two values the sandbox answers with.
SOURCE_CLIENT_ID=sbx_...
SOURCE_CLIENT_SECRET=...
# Optional. The sandbox the source checks tokens at; the hosted one by default.
# LIFECAREID_SANDBOX_ORIGIN=https://sandbox.lifecare.id
